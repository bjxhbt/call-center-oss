<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.och</groupId>
        <artifactId>openCallHub</artifactId>
        <version>0.0.1</version>
    </parent>
    <groupId>com.och</groupId>
    <artifactId>och-ai</artifactId>
    <version>0.0.1</version>
    <name>och-ai</name>
    <description>och-ai</description>

    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 内存库：转写持久化与端到端一致性测试用（不触碰生产 KingbaseES） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.sxwdmjy</groupId>
            <artifactId>och-common</artifactId>
        </dependency>

        <!-- 统一 TTS 层持久化（tts_file / tts_task）。仅作为库依赖，
             运行时由 och-api 提供数据源，不在本模块内启动独立上下文。
             ASR 转写持久化（call_transcript / call_transcript_segment）同样复用。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- ASR 结果推送：复用平台统一 WsMsgPayload / IWebSocketService（前端 CallSyncClient 路由 TRANSCRIPT_* 事件） -->
        <dependency>
            <groupId>com.och</groupId>
            <artifactId>och-websocket</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ASR 通话生命周期接入：桥接/挂断通过 Spring ApplicationEvent 传入（清晰接口，非侵入，不改呼叫核心逻辑） -->
        <dependency>
            <groupId>com.och</groupId>
            <artifactId>och-esl</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 配置元数据（@ConfigurationProperties 提示） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>


        <!-- 统一 TTS Provider 适配：主用云(阿里 NLS)、第二云(腾讯)、本地可选(讯飞占位)。
             业务代码只依赖 com.och.ai.tts.provider.TtsServiceProvider，
             不直接依赖任一云厂商 SDK；SDK 缺失时对应 Provider 自动禁用。 -->
        <dependency>
            <groupId>com.alibaba.nls</groupId>
            <artifactId>nls-sdk-tts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tencentcloudapi</groupId>
            <artifactId>tencentcloud-sdk-java-tts</artifactId>
        </dependency>
       <!-- <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter</artifactId>
        </dependency>-->

        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>1.0.0.2</version>
        </dependency>
        <!--<dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
            <version>1.0.0</version>
        </dependency>-->

    </dependencies>



</project>
