    </resultMap>

  <sql id="selectCallRecordInfoVo">
     
   </sql>
    <select id="getCallPageList" resultType="com.och.system.domain.vo.call.CallRecordVo">
        SELECT
        cr.id,
        cr.call_id,
        cr.caller_number,
        cr.caller_display_number,
        cr.callee_number,
        cr.callee_display_number,
        cr.number_location,
        cr.agent_id,
        cr.agent_number,
        cr.agent_name,
        cr.call_state,
        cr.direction,
        cr.call_start_time,
        cr.call_end_time,
        cr.answer_flag,
        cr.answer_time,
        cr.ringing_time,
        cr.hangup_dir,
        cr.hangup_cause_code,
        cr.file_path,
        cr.ringing_path,
        cr.record_url,
        cr.record_duration,
        cr.record_status,
        cr.satisfaction,
        cr.satisfaction_time,
        cr.gateway_id,
        cr.gateway_name,
        cr.from_gateway_id,
        cr.from_gateway_name,
        cr.did,
        cr.original_callee,
        cr.converted_callee,
        cr.route_id,
        cr.route_name,
        cr.record_start_time,
        cr.record_end_time,
        cr.sip_status,
        cr.failure_reason,
        cr.create_by,
        cr.create_time,
        cr.update_by,
        cr.update_time
        FROM call_record cr
        <where>
            cr.del_flag = 0
            <if test="callId != null and callId != ''">
                AND cr.call_id = #{callId}
            </if>
            <if test="agentNumber != null and agentNumber != ''">
                AND cr.agent_number = #{agentNumber}
            </if>
            <if test="callerNumber != null and callerNumber != ''">
                AND cr.caller_number = #{callerNumber}
            </if>
            <if test="calleeNumber != null and calleeNumber != ''">
                AND cr.callee_number = #{calleeNumber}
            </if>
            <if test="beginTime != null">
                AND cr.call_start_time &gt;= #{beginTime}
            </if>
            <if test="endTime != null">
                AND cr.call_end_time &lt;= #{endTime}
            </if>
            <if test="recordStatus != null">
                AND cr.record_status = #{recordStatus}
            </if>
            <if test="satisfaction != null and satisfaction != ''">
                AND cr.satisfaction = #{satisfaction}
            </if>
            <if test="direction != null">
                AND cr.direction = #{direction}
            </if>
            <if test="gatewayId != null">
                AND cr.gateway_id = #{gatewayId}
            </if>
            <if test="fromGatewayId != null">
                AND cr.from_gateway_id = #{fromGatewayId}
            </if>
            <if test="did != null and did != ''">
                AND cr.did = #{did}
            </if>
            <if test="callState != null">
                AND cr.call_state = #{callState}
            </if>
        </where>
        order by cr.id desc
    </select>

</mapper>
