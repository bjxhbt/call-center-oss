        <result property="recordDuration" column="record_duration" jdbcType="INTEGER"/>
        <result property="recordStatus" column="record_status" jdbcType="INTEGER"/>
        <result property="satisfaction" column="satisfaction" jdbcType="VARCHAR"/>
        <result property="satisfactionTime" column="satisfaction_time" jdbcType="TIMESTAMP"/>
        <result property="gatewayId" column="gateway_id" jdbcType="BIGINT"/>
        <result property="gatewayName" column="gateway_name" jdbcType="VARCHAR"/>
