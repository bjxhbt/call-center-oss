# Copy to .env; fill with private credentials or use the provided preparation tool.
OCH_DOCKER_NETWORK=replace_with_shared_docker_network
OCH_DB_HOST=mysql8
OCH_DB_PORT=3306
OCH_DB_NAME=xhbt_demo
OCH_DB_USER=replace_with_mysql_user
OCH_DB_PASSWORD=
OCH_DB_URL='jdbc:mysql://mysql8:3306/xhbt_demo?characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true'
OCH_REDIS_HOST=redis
OCH_REDIS_PORT=6379
OCH_REDIS_PASSWORD=
OCH_REDIS_DATABASE=10
OCH_WEB_BIND_ADDRESS=127.0.0.1
OCH_WEB_PORT=8088
OCH_PUBLIC_HOST=127.0.0.1
OCH_FS_PUBLIC_IP=auto
OCH_SIP_BIND_ADDRESS=127.0.0.1
# Generate four different random secrets. Private packages include generated values.
OCH_FS_ESL_PASSWORD=
OCH_FS_XML_CURL_SECRET=
OCH_FS_SIP_PASSWORD_1001=
OCH_FS_SIP_PASSWORD_1002=
