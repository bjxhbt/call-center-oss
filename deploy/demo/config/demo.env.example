# Copy to config/demo.env. Never share that local file after adding passwords.
# Use a NEW EMPTY MySQL 8.4 database, not an existing business database.
OCH_DB_HOST=127.0.0.1
OCH_DB_PORT=3306
OCH_DB_NAME=xhbt_demo
OCH_DB_USER=xhbt_demo
# OCH_DB_PASSWORD is requested interactively on Windows if not exported.
# OCH_DB_PASSWORD=
OCH_REDIS_HOST=127.0.0.1
OCH_REDIS_PORT=6379
OCH_REDIS_DATABASE=10
# OCH_REDIS_PASSWORD=
OCH_API_PORT=14320
OCH_FILE_PORT=19527
OCH_WEB_PORT=8088
OCH_WEB_BIND_ADDRESS=127.0.0.1
OCH_PUBLIC_HOST=127.0.0.1
# For LAN access, set OCH_WEB_BIND_ADDRESS=0.0.0.0 and OCH_PUBLIC_HOST to your IP.
# Do not expose the demo to the Internet. HTTPS is needed for remote WebRTC.
