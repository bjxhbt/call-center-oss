worker_processes 1;
error_log logs/nginx-error.log warn;
pid runtime/nginx.pid;
events { worker_connections 512; }
http {
    include mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    sendfile on;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    server {
        listen __WEB_BIND__:__WEB_PORT__;
        server_name _;
        root web;
        index index.html;
        client_max_body_size 20m;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        location = /healthz { default_type text/plain; return 200 'frontend ready\n'; }
        location ~ ^/(auth|call|system|captcha|v1|fs|customer|knowledge|intent|storage|asr|tts|ws|v3|swagger-ui)(/|$) {
            proxy_pass http://127.0.0.1:__API_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }
        location = /index.html { add_header Cache-Control 'no-store'; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
